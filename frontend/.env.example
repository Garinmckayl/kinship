# Copy to .env.local (never commit secrets)
# Postgres (Neon). Note: pg driver strips channel_binding automatically.
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require
AUTH_SECRET=generate-with-openssl-rand-hex-32
REPORT_SECRET=pick-a-long-random-string

# Amazon Bedrock / Strands Agents. Optional: without AWS credentials, Kinship
# uses its deterministic local fallback. Standard AWS credential resolution is
# supported (AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY, a profile, or workload IAM).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional Bedrock bearer auth and model override.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=

ELEVENLABS_API_KEY=
# Optional voice override (default: Sarah — warm, reassuring)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ElevenAgents public browser agent. Public agents use the agent ID in the
# client; private caregiver agents use ELEVENLABS_AGENT_ID + /api/eleven/signed-url.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_ID=
# Required for ElevenAgents webhook tools and post-call transcript ingestion.
ELEVENLABS_TOOL_SECRET=
ELEVENLABS_WEBHOOK_SECRET=

# Background tasks (Inngest). Optional for demo — without these, tasks run inline.
# Local dev: INNGEST_DEV=1 (+ `npx inngest-cli dev` for the full durable loop)
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Real phone calls (Twilio). Without these, call_elder degrades to family escalation.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ELDER_PHONE_NUMBER=
# WhatsApp voice loop (Meta Cloud API — FREE, works in Ethiopia).
# Setup: developers.facebook.com -> create app -> WhatsApp -> API Setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ELDER_WHATSAPP_NUMBER=
WHATSAPP_VERIFY_TOKEN=elderlove-verify
# Google Calendar service-account sync (optional; local calendar works without)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
# Daily report recipients (WhatsApp text + email via Resend)
CAREGIVER_WHATSAPP_NUMBER=
CAREGIVER_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=ElderLove <alerts@elderlove.app>
# Shared secret protecting /api/voice/trigger + /api/whatsapp/send
VOICE_CALLBACK_SECRET=
# Public base URL so Twilio/Inngest can reach webhooks (e.g. https://elderlove.vercel.app)
PUBLIC_BASE_URL=

# Nova Act browser worker. Optional; browser tasks remain approval-gated.
NOVA_SIDECAR_URL=http://localhost:8100
NOVA_SIDECAR_SECRET=elderlove-nova-dev
# Set instead of NOVA_SIDECAR_URL when invoking the AgentCore runtime directly.
NOVA_AGENTCORE_RUNTIME=

# Welfare windows and UI-only integration indicator (optional).
WELFARE_QUIET_MINUTES=360
NEXT_PUBLIC_HAS_WHATSAPP=
