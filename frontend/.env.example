# Copy to .env.local (never commit secrets)
ELEVENLABS_API_KEY=
# Optional voice override (default: Sarah — warm, reassuring)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Background tasks (Inngest). Optional for demo — without these, tasks run inline.
# Local dev: INNGEST_DEV=1 (+ `npx inngest-cli dev` for the full durable loop)
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Real phone calls (Twilio). Without these, call_elder degrades to family escalation.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ELDER_PHONE_NUMBER=
# Shared secret protecting /api/voice/trigger
VOICE_CALLBACK_SECRET=
# Public base URL so Twilio/Inngest can reach webhooks (e.g. https://elderlove.vercel.app)
PUBLIC_BASE_URL=
